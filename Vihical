<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Parking Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #e0f2fe, #f8fafc);
            color: #1e293b;
        }

        /* HEADER */
        header {
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            color: white;
            padding: 20px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        header h1 {
            font-size: 26px;
        }

        header p {
            font-size: 13px;
            color: #bfdbfe;
            margin-top: 5px;
        }

        .logo {
            font-size: 38px;
        }

        /* MAIN */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        /* DASHBOARD CARDS */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            text-align: center;
            border-left: 5px solid #2563eb;
        }

        .card h2 {
            color: #2563eb;
            font-size: 30px;
            margin: 8px 0;
        }

        .card p {
            color: #64748b;
            font-weight: bold;
        }

        /* SECTIONS */
        .section {
            background: white;
            padding: 25px;
            border-radius: 18px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .section h2 {
            margin-bottom: 20px;
            color: #0f172a;
        }

        /* FORM */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        input,
        select {
            width: 100%;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            font-size: 15px;
        }

        input:focus,
        select:focus {
            border-color: #2563eb;
        }

        button {
            border: none;
            padding: 13px 20px;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
        }

        .full-btn {
            width: 100%;
            margin-top: 15px;
        }

        /* PARKING AREA */
        .parking-area {
            background: #e2e8f0;
            padding: 25px;
            border-radius: 15px;
        }

        .parking-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
        }

        .slot {
            min-height: 100px;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            color: white;
            cursor: pointer;
            transition: 0.3s;
        }

        .slot:hover {
            transform: scale(1.05);
        }

        .available {
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .occupied {
            background: linear-gradient(135deg, #dc2626, #ef4444);
            cursor: not-allowed;
        }

        .selected {
            background: linear-gradient(135deg, #f59e0b, #f97316);
        }

        .slot-number {
            font-size: 20px;
            font-weight: bold;
        }

        .car {
            font-size: 30px;
            margin: 8px;
        }

        /* SEARCH */
        .search-box {
            margin-bottom: 20px;
        }

        /* TABLE */
        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 13px;
            border-bottom: 1px solid #e2e8f0;
            text-align: center;
        }

        th {
            background: #1e3a8a;
            color: white;
        }

        tr:hover {
            background: #f8fafc;
        }

        .delete-btn {
            background: #dc2626;
            padding: 8px 12px;
        }

        .delete-btn:hover {
            background: #b91c1c;
        }

        /* STATUS */
        #message {
            margin-top: 15px;
            padding: 12px;
            border-radius: 8px;
            display: none;
            font-weight: bold;
        }

        .success {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
        }

        /* FOOTER */
        footer {
            background: #0f172a;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .dashboard {
                grid-template-columns: repeat(2, 1fr);
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .parking-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 600px) {
            header {
                padding: 18px;
            }

            header h1 {
                font-size: 20px;
            }

            .container {
                width: 94%;
            }

            .dashboard {
                grid-template-columns: 1fr;
            }

            .parking-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>

<body>

<header>
    <div>
        <h1>🚗 Smart Parking Management</h1>
        <p>API-Based Smart Parking System</p>
    </div>

    <div class="logo">🅿️</div>
</header>


<div class="container">

    <!-- DASHBOARD -->
    <div class="dashboard">

        <div class="card">
            <p>Total Slots</p>
            <h2 id="totalSlots">20</h2>
        </div>

        <div class="card">
            <p>Available</p>
            <h2 id="availableSlots">20</h2>
        </div>

        <div class="card">
            <p>Occupied</p>
            <h2 id="occupiedSlots">0</h2>
        </div>

        <div class="card">
            <p>Total Revenue</p>
            <h2>₹<span id="revenue">0</span></h2>
        </div>

    </div>


    <!-- VEHICLE ENTRY -->
    <div class="section">

        <h2>🚘 Vehicle Entry & Parking Booking</h2>

        <div class="form-grid">

            <input
                type="text"
                id="vehicleNumber"
                placeholder="Vehicle Number (MH12AB1234)"
            >

            <select id="vehicleType">
                <option value="">Select Vehicle Type</option>
                <option value="Car">🚗 Car</option>
                <option value="Bike">🏍 Bike</option>
                <option value="SUV">🚙 SUV</option>
            </select>

            <select id="duration">
                <option value="">Parking Duration</option>
                <option value="1">1 Hour</option>
                <option value="2">2 Hours</option>
                <option value="3">3 Hours</option>
                <option value="4">4 Hours</option>
                <option value="5">5 Hours</option>
            </select>

        </div>

        <button class="full-btn" onclick="bookParking()">
            🅿️ Book Selected Parking Slot
        </button>

        <div id="message"></div>

    </div>


    <!-- PARKING SLOTS -->
    <div class="section">

        <h2>🅿️ Parking Slot Management</h2>

        <div class="parking-area">

            <div class="parking-grid" id="parkingGrid"></div>

        </div>

    </div>


    <!-- SEARCH -->
    <div class="section">

        <h2>🔍 Search Vehicle</h2>

        <div class="search-box">
            <input
                type="text"
                id="searchVehicle"
                placeholder="Enter vehicle number..."
                onkeyup="searchVehicle()"
            >
        </div>

        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Type</th>
                        <th>Slot</th>
                        <th>Duration</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="bookingTable"></tbody>

            </table>

        </div>

    </div>

</div>


<footer>
    <p>© 2026 Smart Parking Management System | HTML • CSS • JavaScript • API</p>
</footer>


<script>

    // ===============================
    // PARKING DATA
    // ===============================

    let slots = [];

    let bookings = [];

    let totalRevenue = 0;

    const TOTAL_SLOTS = 20;


    // ===============================
    // INITIALIZE PARKING
    // ===============================

    function initializeParking() {

        for (let i = 1; i <= TOTAL_SLOTS; i++) {

            slots.push({
                id: i,
                status: "available",
                vehicle: null
            });

        }

        displaySlots();
        updateDashboard();
    }


    // ===============================
    // DISPLAY PARKING SLOTS
    // ===============================

    function displaySlots() {

        const grid = document.getElementById("parkingGrid");

        grid.innerHTML = "";

        slots.forEach(slot => {

            const div = document.createElement("div");

            div.classList.add("slot");

            if (slot.status === "available") {

                div.classList.add("available");

                div.onclick = function() {
                    selectSlot(slot.id);
                };

            } else {

                div.classList.add("occupied");

            }


            div.innerHTML = `

                <div class="slot-number">
                    Slot ${slot.id}
                </div>

                <div class="car">
                    ${slot.status === "available" ? "🅿️" : "🚗"}
                </div>

                <small>
                    ${slot.status === "available"
                        ? "Available"
                        : slot.vehicle}
                </small>

            `;

            grid.appendChild(div);

        });

    }


    // ===============================
    // SELECT SLOT
    // ===============================

    let selectedSlot = null;


    function selectSlot(slotId) {

        selectedSlot = slotId;

        document.querySelectorAll(".slot").forEach(slot => {
            slot.classList.remove("selected");
        });

        const slotsElements =
            document.querySelectorAll(".slot");

        slotsElements[slotId - 1].classList.add("selected");

        showMessage(
            "Slot " + slotId + " selected successfully!",
            "success"
        );

    }


    // ===============================
    // BOOK PARKING
    // ===============================

    function bookParking() {

        const vehicleNumber =
            document.getElementById("vehicleNumber").value
            .trim()
            .toUpperCase();

        const vehicleType =
            document.getElementById("vehicleType").value;

        const duration =
            document.getElementById("duration").value;


        if (!vehicleNumber || !vehicleType || !duration) {

            showMessage(
                "Please fill all details.",
                "error"
            );

            return;
        }


        if (!selectedSlot) {

            showMessage(
                "Please select a parking slot.",
                "error"
            );

            return;
        }


        const slot = slots.find(
            s => s.id === selectedSlot
        );


        if (slot.status === "occupied") {

            showMessage(
                "This slot is already occupied.",
                "error"
            );

            return;
        }


        // Prevent duplicate vehicle

        const existingVehicle =
            bookings.find(
                b => b.vehicle === vehicleNumber
            );


        if (existingVehicle) {

            showMessage(
                "This vehicle is already parked.",
                "error"
            );

            return;
        }


        // Parking fee

        let rate = 50;

        if (vehicleType === "Bike") {
            rate = 30;
        }

        if (vehicleType === "SUV") {
            rate = 80;
        }


        const amount =
            rate * Number(duration);


        // Update slot

        slot.status = "occupied";

        slot.vehicle = vehicleNumber;


        // Create booking

        const booking = {

            id: Date.now(),

            vehicle: vehicleNumber,

            type: vehicleType,

            slot: selectedSlot,

            duration: duration,

            amount: amount

        };


        bookings.push(booking);

        totalRevenue += amount;


        // Reset

        selectedSlot = null;

        document.getElementById("vehicleNumber").value = "";

        document.getElementById("vehicleType").value = "";

        document.getElementById("duration").value = "";


        displaySlots();

        updateDashboard();

        displayBookings();


        showMessage(
            "Parking booked successfully! Amount: ₹" + amount,
            "success"
        );

    }


    // ===============================
    // UPDATE DASHBOARD
    // ===============================

    function updateDashboard() {

        const occupied =
            slots.filter(
                slot => slot.status === "occupied"
            ).length;

        const available =
            TOTAL_SLOTS - occupied;


        document.getElementById("totalSlots")
            .innerText = TOTAL_SLOTS;

        document.getElementById("availableSlots")
            .innerText = available;

        document.getElementById("occupiedSlots")
            .innerText = occupied;

        document.getElementById("revenue")
            .innerText = totalRevenue;

    }


    // ===============================
    // DISPLAY BOOKINGS
    // ===============================

    function displayBookings(data = bookings) {

        const table =
            document.getElementById("bookingTable");

        table.innerHTML = "";


        if (data.length === 0) {

            table.innerHTML = `
                <tr>
                    <td colspan="6">
                        No booking found
                    </td>
                </tr>
            `;

            return;
        }


        data.forEach(booking => {

            const row =
                document.createElement("tr");


            row.innerHTML = `

                <td>${booking.vehicle}</td>

                <td>${booking.type}</td>

                <td>Slot ${booking.slot}</td>

                <td>${booking.duration} Hour(s)</td>

                <td>₹${booking.amount}</td>

                <td>
                    <button
                        class="delete-btn"
                        onclick="removeVehicle(${booking.id})">
                        Exit
                    </button>
                </td>

            `;

            table.appendChild(row);

        });

    }


    // ===============================
    // VEHICLE EXIT
    // ===============================

    function removeVehicle(id) {

        const booking =
            bookings.find(
                b => b.id === id
            );


        if (!booking) return;


        const slot =
            slots.find(
                s => s.id === booking.slot
            );


        if (slot) {

            slot.status = "available";

            slot.vehicle = null;

        }


        bookings =
            bookings.filter(
                b => b.id !== id
            );


        displaySlots();

        updateDashboard();

        displayBookings();


        showMessage(
            "Vehicle " + booking.vehicle +
            " exited successfully.",
            "success"
        );

    }


    // ===============================
    // SEARCH VEHICLE
    // ===============================

    function searchVehicle() {

        const search =
            document.getElementById("searchVehicle")
            .value
            .toUpperCase();


        const filtered =
            bookings.filter(
                booking =>
                    booking.vehicle.includes(search)
            );


        displayBookings(filtered);

    }


    // ===============================
    // MESSAGE
    // ===============================
    function showMessage(text, type) {

        const message =
            document.getElementById("message");

        message.innerText = text;

        message.className = type;

        message.style.display = "block";


        setTimeout(() => {

            message.style.display = "none";

        }, 3000);

    }


    // ===============================
    // START APPLICATION
    // ===============================

    initializeParking();

</script>

</body>
</html>
